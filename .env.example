# Copy to .env and fill in. Never share or commit .env.
# GMGN OpenAPI key (free, gmgn.ai/ai): holders, insiders, bundlers, phishing, snipers, dev, smart money, socials and
# launches on every launchpad. Without it the scanner falls back to GeckoTerminal / GoPlus / RugCheck (sees less).
GMGN_API_KEY=
# Telegram: token from @BotFather, your chat id. Without these, calls are printed to the log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional Telegram settings (defaults in config.yaml): a forum topic, outcome replies, their sound, the daily
# summary time (e.g. 06:00 or off), chat commands (needs a bot no other app polls), and the hourly call cap.
TELEGRAM_THREAD_ID=
TELEGRAM_OUTCOME_UPDATES=
TELEGRAM_SILENT_OUTCOMES=
TELEGRAM_DAILY_SUMMARY_UTC=
TELEGRAM_COMMANDS=
CALLS_PER_HOUR=
# Only needed when the dashboard is reachable beyond this PC (VPS). Use a long random password.
DASHBOARD_PASSWORD=
# Optional: a private Solana RPC websocket, e.g. wss://mainnet.helius-rpc.com/?api-key=... (free tier is enough).
# The default public endpoint works but can drop; every drop costs a few minutes of pump.fun data.
SOLANA_WS_URL=
# Optional, free: CoinGecko Demo API key (coingecko.com/en/api) - raises the launch-discovery limit from ~5 to 30 calls/min.
COINGECKO_DEMO_API_KEY=
# Optional: Anthropic API key - Claude rates each near-call candidate's meme / narrative (capped per day in config.yaml).
ANTHROPIC_API_KEY=
# VPS only, optional: another DNS name for the dashboard (default: the Hostinger hostname, under /radar/)
DOMAIN=
